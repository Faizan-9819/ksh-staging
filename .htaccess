# This file currently serves the temporary Cloudways domain
# (https://phpstack-819107-6623514.cloudwaysapps.com/) and will continue to
# serve https://www.kshinfra.com/ once DNS is pointed here — no changes
# needed at cutover. Rules 1-3 below (the /home rewrite, static file
# passthrough, and proxy to the Node app on port 5000) are host-agnostic:
# they match on request path only, not on Host header, so they behave
# identically on both domains. Only the explicit 301 redirects further down
# hardcode kshinfra.com as a destination, which is intentional — they should
# always send visitors to the final production domain, even while the temp
# domain is still in use.

# Redirect non-www to www
RewriteCond %{HTTP_HOST} ^kshinfra\.com$ [NC]
RewriteRule ^(.*)$ https://www.kshinfra.com/$1 [L,R=301]

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 🔹 Custom Redirects
  # Delete /test (410 Gone)
  RewriteRule ^test$ - [G,L]

  # Case Studies
  RewriteRule ^kawasaki$ https://www.kshinfra.com/case-studies/kawasaki [R=301,L]
  RewriteRule ^jabil$ https://www.kshinfra.com/case-studies/jabil [R=301,L]

  # Talegaon
  RewriteRule ^ksh-talegaon$ https://www.kshinfra.com/ksh-talegaon-i [R=301,L]

  # Blogs & News categories
  RewriteRule ^category/news$ https://www.kshinfra.com/blogs?tab=news [R=301,L]
  RewriteRule ^category/blogs$ https://www.kshinfra.com/blogs [R=301,L]
  RewriteRule ^blogs/page/[0-9]+$ https://www.kshinfra.com/blogs [R=301,L]
  RewriteRule ^category/blogs/page/[0-9]+$ https://www.kshinfra.com/blogs [R=301,L]

  # News single posts → News tab

  # PDFs moved to /brochure
  RewriteRule ^wp-content/uploads/2022/12/KSH-Chakan-Park-3-Brochure\.pdf$ https://www.kshinfra.com/brochure/KSH-Chakan-Park-3-Brochure.pdf [R=301,L]
  RewriteRule ^wp-content/uploads/2022/12/KSH-Infra-Chakan-Park-2-Brochure\.pdf$ https://www.kshinfra.com/brochure/KSH-Infra-Chakan-Park-2-Brochure.pdf [R=301,L]

  # Rule 1: Internally rewrite the root URL to /home
  RewriteRule ^$ /home [L]

  # Rule 2: Let Apache serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rule 3: Proxy all other requests (including the rewritten /home) to your Next.js app
  RewriteRule ^(.*)$ http://128.199.31.44:5000/$1 [P,L]
</IfModule>

# Optional: Disable directory browsing for security
Options -Indexes

# Optional: Set index file (though less relevant with the proxy setup)
DirectoryIndex index.html
